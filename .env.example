# Optional: the application works locally without copying this file.
NEXT_PUBLIC_DEPLOYMENT_ENV=development
# Set only after choosing an actual origin. Production requires HTTPS.
NEXT_PUBLIC_SITE_URL=

# Phase 1 supports disabled registration only. No integration is active.
REGISTRATION_PROVIDER=disabled
# Reserved private configuration; leave blank in Phase 1.
DATABASE_URL=
RATE_LIMIT_SECRET=

# Disable Next.js framework telemetry for local development.
NEXT_TELEMETRY_DISABLED=1
